# ===========================
# Docker Compose 环境配置示例
# 启动前请复制为 .env.compose 并按实际部署环境修改
# ===========================

# 前端服务端口（容器内固定 80，此处映射宿主机端口）
# 所有请求通过 Nginx 统一入口：/admin/api → 管理后台，/v1 → AI 接口
FRONTEND_PORT=3990

# JWT 签名密钥（建议设置为 64 字节以上的随机字符串）
# 未设置时使用内置默认密钥（仅适合开发环境）
APP_JWT_SECRET=

# Prometheus /actuator/prometheus 端点访问令牌（留空则公开访问）
ACTUATOR_ACCESS_TOKEN=